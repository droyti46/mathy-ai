# Database
DATABASE_URL=sqlite+aiosqlite:///var/app.db

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_CHECK=deepseek/deepseek-r1
LLM_MODEL_ASSISTANT=deepseek/deepseek-r1
LLM_MODEL_SOLVE=deepseek/deepseek-r1
LLM_MODEL_VISION=google/gemini-2.5-pro
STRICT_JSON=true

# NScale
NSCALE_SERVICE_TOKEN=
NSCALE_BASE_URL=https://inference.api.nscale.com/v1
NSCALE_MODEL_CHECK=qwen/qwen-3-4b-thinking-2507
NSCALE_MODEL_SOLVE=qwen/qwen-3-4b-thinking-2507

# Data/Storage
DATA_PATH=data/tasks.csv
THEORY_PATH=data/theory.csv
STORAGE_DIR=var/storage
TEACHER_MODE=true

# Auth
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_EXPIRES_MIN=120
REFRESH_EXPIRES_DAYS=14
